# ---------------------------------------------------------------------------
# Move - environment configuration
# Copy this file to .env and fill in the two keys marked REQUIRED.
# ---------------------------------------------------------------------------

# REQUIRED - Google AI Studio API key (free, no billing account needed).
# Get one at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Gemma model id served by the AI Studio / Generative Language API.
# Run `npm run models` after setting the key above to list what your key can
# actually see, then set this to the Gemma 4 id you want.
GEMMA_MODEL=gemma-4-26b-a4b-it

# REQUIRED - Mapbox access token, used for ROUTING only (free tier, no card).
# Get one at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Destination search. Backed by OpenStreetMap through Photon, which needs no
# API key. Mapbox routes Ghana well but barely knows its place names - it has
# no result at all for "Achimota" or "Presec" - so search uses a different
# provider from routing.
# ---------------------------------------------------------------------------

# ISO 3166-1 alpha-2. Results outside this country are discarded.
SEARCH_COUNTRY_CODE=GH

# "west,south,east,north". Narrows the geocoder index before ranking.
# The default is Ghana.
SEARCH_BBOX=-3.26,4.71,1.21,11.18

# Photon is a free public instance run by Komoot. It is fine for a demo, but
# point this at your own instance for production traffic.
PHOTON_URL=https://photon.komoot.io

# ---------------------------------------------------------------------------
# Route map. Rendered by the Mapbox Static Images API and proxied through
# /api/map/<id>.png, so the access token never reaches a browser.
# ---------------------------------------------------------------------------

# Navigation styles paint their own traffic colours, which fight with the
# green/blue this app uses to mean dry/wet. dark-v11 stays out of the way.
MAP_STYLE=dark-v11

# Retina doubles the bytes for an image that is glanced at once. 640x360 is
# about 77 KB; "640x360@2x" is roughly 280 KB.
MAP_SIZE=640x360

# ---------------------------------------------------------------------------
# Web Push (VAPID). Generate a fresh pair with `npm run keys` and paste here.
# Without these the app still works, only push notifications are disabled.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@move.app

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Where the SQLite file lives. ":memory:" is valid for throwaway runs.
DATABASE_PATH=./data/move.sqlite

# How often the proactive departure-window job re-checks saved destinations.
NOTIFICATION_CRON_MINUTES=7

# Upstream timeouts in milliseconds. Kept deliberately tight: on a weak mobile
# connection we would rather serve a cached answer fast than hang the UI.
UPSTREAM_TIMEOUT_MS=8000
LLM_TIMEOUT_MS=35000
