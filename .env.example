# ---------------------------------------------------------------------------
# Move - environment configuration
# Copy this file to .env and fill in the two keys marked REQUIRED.
# ---------------------------------------------------------------------------

# REQUIRED - Google AI Studio API key (free, no billing account needed).
# Get one at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Gemma model id served by the AI Studio / Generative Language API.
# Run `npm run models` after setting the key above to list what your key can
# actually see, then set this to the Gemma 4 id you want.
GEMMA_MODEL=gemma-4-26b-a4b-it

# REQUIRED - Mapbox public access token (free tier, no card required).
# Get one at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Web Push (VAPID). Generate a fresh pair with `npm run keys` and paste here.
# Without these the app still works, only push notifications are disabled.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@move.app

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Where the SQLite file lives. ":memory:" is valid for throwaway runs.
DATABASE_PATH=./data/move.sqlite

# How often the proactive departure-window job re-checks saved destinations.
NOTIFICATION_CRON_MINUTES=7

# Upstream timeouts in milliseconds. Kept deliberately tight: on a weak mobile
# connection we would rather serve a cached answer fast than hang the UI.
UPSTREAM_TIMEOUT_MS=8000
LLM_TIMEOUT_MS=35000
